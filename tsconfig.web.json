{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "electron/common/**/*.ts",
    "electron/preload/**/*.ts"
  ],
  "exclude": ["out", "dist", "release", "node_modules"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "element-plus/global"],
    /**
     * 别名必须与 electron.vite.config.ts 里 renderer.resolve.alias 保持一致
     */
    "baseUrl": ".",
    "paths": {
      "@common/*": ["electron/common/*"],
      "@/*": ["src/*"]
    }
  }
}
