{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts",
    "electron/**/*.d.ts"
  ],
  "exclude": ["out", "dist", "release", "node_modules"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node", "electron"],
    "lib": ["ES2023"],
    /**
     * 别名必须与 electron.vite.config.ts 里的 resolve.alias 保持一致
     */
    "baseUrl": ".",
    "paths": {
      "@common/*": ["electron/common/*"],
      "@main/*": ["electron/main/*"]
    }
  }
}
